msgstr "افزودن %s"

msgid "Add specification"
msgstr "افزودن مشخصه"

msgid "Brands"
msgstr "برندها"

msgid "Choose a published public page for inquiries."
msgstr "برای استعلام یک برگهٔ عمومی منتشرشده انتخاب کنید."

msgid "Choose images"
msgstr "انتخاب تصاویر"

msgid "Contact page"
