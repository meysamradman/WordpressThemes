msgid "Specification label"
msgstr "عنوان مشخصه"

msgid "Specification value"
msgstr "مقدار مشخصه"

msgid "Specification unit"
msgstr "واحد مشخصه"

msgid "Displayed price"
msgstr "متن قیمت نمایشی"

msgid "No public contact page is available for this language. The contact button will stay hidden until a published page is selected in Core settings."
msgstr "برای این زبان برگهٔ تماس عمومی در دسترس نیست. دکمهٔ تماس تا انتخاب یک برگهٔ منتشرشده در تنظیمات هسته نمایش داده نمی‌شود."

msgid "Choose a contact page in Core settings"
msgstr "انتخاب برگهٔ تماس در تنظیمات هسته"

msgid "Image"
msgstr "تصویر"

msgid "Price not entered"
msgstr "قیمت وارد نشده"

msgid "All: %s"
msgstr "همه: %s"

msgid "Product price display"
msgstr "نمایش قیمت محصول"

msgid "Contact us"
msgstr "تماس با ما"

msgid "Price"
msgstr "قیمت"

msgid "Enter the price and currency as display text. This does not enable online purchasing."
msgstr "قیمت و واحد پول را به‌صورت متن وارد کنید؛ این گزینه خرید اینترنتی را فعال نمی‌کند."

msgid "Uses the contact page selected in Core settings. No form or request submission is created."
msgstr "از برگهٔ تماس انتخاب‌شده در تنظیمات هسته استفاده می‌شود؛ فرم یا ارسال درخواست ساخته نمی‌شود."

msgid "The product details editor could not load. Saved values were preserved."
msgstr "ویرایشگر جزئیات محصول بارگذاری نشد؛ اطلاعات ذخیره‌شدهٔ قبلی حفظ شده‌اند."

msgid "Product contact link"
msgstr "پیوند تماس محصولات"

msgid "No contact link"
msgstr "بدون پیوند تماس"

msgid "Used when a product displays Contact us instead of a price. This does not create a form or submit requests."
msgstr "برای محصولاتی است که به‌جای قیمت «تماس با ما» نمایش می‌دهند؛ فرم یا ارسال درخواست ساخته نمی‌شود."

msgid "Choose a published public contact page."
msgstr "یک برگهٔ تماس عمومی و منتشرشده انتخاب کنید."

msgid "Find a contact page"
msgstr "جستجوی برگهٔ تماس"

msgid "Save your changes before running another page search."
msgstr "پیش از جستجوی دوبارهٔ برگه‌ها، تغییرات خود را ذخیره کنید."

msgid "Products, categories, brands, features, galleries and technical specifications. No cart or checkout."
msgstr "محصولات، دسته‌ها، برندها، ویژگی‌ها، گالری و مشخصات فنی؛ بدون سبد خرید و پرداخت."

msgid "Projects, categories and image galleries. Independent of the product catalog."
msgstr "نمونه‌کارها، دسته‌ها و گالری تصاویر؛ مستقل از کاتالوگ محصول."

msgid "Enabled"
msgstr "فعال"

msgid "Disabled"
msgstr "غیرفعال"

msgid "Enable this module"
msgstr "فعال‌کردن این ماژول"

msgid "Manage items"
msgstr "مدیریت موارد"

msgid "Add item"
msgstr "افزودن مورد"

msgid "View archive"
msgstr "مشاهدهٔ آرشیو"

msgid "Enable only the modules used by this project. After saving, each enabled module provides its own management menu and archive."
msgstr "فقط ماژول‌های مورد نیاز پروژه را فعال کنید. پس از ذخیره، هر ماژول فعال منوی مدیریت و آرشیو خودش را دارد."

msgid "Find an inquiry destination page"
msgstr "جستجوی برگهٔ مقصد استعلام"

msgid "Search pages"
msgstr "جستجوی برگه‌ها"

msgid "Untitled page"
msgstr "برگهٔ بدون عنوان"

msgid "Shows up to 20 matching public pages and the saved selection. Use the page search above to find another destination."
msgstr "حداکثر ۲۰ برگهٔ عمومی مطابق جستجو و انتخاب ذخیره‌شده نمایش داده می‌شود. برای یافتن مقصد دیگر، از جستجوی برگه‌ها در بالا استفاده کنید."

msgid "No matching public pages. Search again or publish a contact page first."
msgstr "برگهٔ عمومی مطابق جستجو پیدا نشد. دوباره جستجو کنید یا ابتدا برگهٔ تماس را منتشر کنید."

