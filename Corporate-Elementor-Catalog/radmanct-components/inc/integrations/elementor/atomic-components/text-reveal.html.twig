{% import 'radmanct/attributes' as rdct_attributes %}
{% import 'elementor/macros' as m %}
<div class="{{ settings.classes | default([]) | join(' ') | e('html_attr') }}" data-interaction-id="{{ interaction_id | e('html_attr') }}" {{ rdct_attributes.render(settings) }}>
  <div data-rdct-atomic-text-reveal data-options="{{ settings | json_encode | e('html_attr') }}">{{ settings.text | e }}</div>
</div>
